# Compiled binaries
*.exe

# Editor settings
/.vscode

# npm dependencies — restored by `npm install`
frontend/node_modules/

# Vite build output — regenerated by `npm run build` or `wails3 build`
frontend/dist/
# Keep the go:embed placeholder so `go build` works before the frontend is built
!frontend/dist/index.html

# Wails-generated JS bindings — regenerated by `wails3 generate bindings`
frontend/bindings/

# Stray duplicate bindings dir created by running wails3 from wrong directory
frontend/frontend/

# Stray root-level npm lockfile (frontend/package-lock.json is intentional)
/package-lock.json